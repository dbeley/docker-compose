# Rename this file to .env
# Full reference: https://github.com/liketrek/TREK#environment-variables

# Required for Traefik
DEFAULT_NETWORK=traefik-network
DOMAIN=yourdomain.home

# Required: at-rest encryption key. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
TZ=UTC
# Comma-separated origins for CORS and email links
ALLOWED_ORIGINS=

# Optional
# APP_URL=https://trek.example.com
# FORCE_HTTPS=true
# TRUST_PROXY=1
# ADMIN_EMAIL=admin@trek.local
# ADMIN_PASSWORD=