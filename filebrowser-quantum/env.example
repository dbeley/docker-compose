# Rename this file to .env
# Docs: https://filebrowserquantum.com/en/docs/getting-started/docker/

# Required for Traefik
DEFAULT_NETWORK=traefik-network
DOMAIN=yourdomain.home

# Required: host folder to expose in the browser. Path is from the host perspective.
SOURCE_FOLDER=/path/to/your/folder

# Optional
# TZ=UTC