# Rename this file to .env
# Full reference: https://docs.linkwarden.app/self-hosting/environment-variables

# Required for Traefik
DEFAULT_NETWORK=traefik-network
DOMAIN=yourdomain.home

# Required: generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Database password (change it)
LINKWARDEN_DB_PASSWORD=change_me

# Meilisearch: generate with: openssl rand -hex 16
MEILI_MASTER_KEY=

# Optional
# NEXT_PUBLIC_DISABLE_REGISTRATION=true
# TZ=UTC
# PAGINATION_TAKE_COUNT=100
# NEXT_PUBLIC_EMAIL_PROVIDER=smtp
# EMAIL_FROM=linkwarden@example.com
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
